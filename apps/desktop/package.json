{
  "name": "@skyra/jarvis-desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "pnpm build && playwright test",
    "tauri": "tauri",
    "format": "prettier --write src \"tests/*.{ts,mjs}\" *.ts *.json",
    "format:check": "prettier --check src \"tests/*.{ts,mjs}\" *.ts *.json",
    "test:native": "node tests/native-smoke.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.3",
    "@xyflow/react": "12.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "packageManager": "pnpm@11.25.0"
}
